      <doc xml:space="preserve"
           filename="gum/gummemory.c"
           line="1487">Scans @ranges for pointer-aligned words matching any of @values, comparing
under @mask. Use %G_MAXSIZE for an exact match, or e.g.
0x00007ffffffffff8 to strip arm64e PAC and non-pointer-isa bits.</doc>
      <source-position filename="gum/gummemory.h" line="142"/>
      <return-value transfer-ownership="full">
        <doc xml:space="preserve"
             filename="gum/gummemory.c"
             line="1499">the matches, sorted
         by address</doc>
        <array name="GLib.Array" c:type="GArray*">
          <type name="PointerMatch"/>
        </array>
      </return-value>
      <parameters>
        <parameter name="ranges" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/gummemory.c"
               line="1489">the #GumMemoryRange instances to scan</doc>
          <array length="1" zero-terminated="0" c:type="const GumMemoryRange*">
            <type name="MemoryRange" c:type="GumMemoryRange"/>
          </array>
        </parameter>
        <parameter name="n_ranges" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/gummemory.c"
               line="1490">the number of @ranges</doc>
          <type name="guint" c:type="guint"/>
        </parameter>
        <parameter name="values" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/gummemory.c"
               line="1491">the pointer-width values to look for</doc>
          <array length="3" zero-terminated="0" c:type="const gsize*">
            <type name="gsize" c:type="gsize"/>
          </array>
        </parameter>
        <parameter name="n_values" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/gummemory.c"
               line="1492">the number of @values</doc>
          <type name="guint" c:type="guint"/>
        </parameter>
        <parameter name="mask" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/gummemory.c"
               line="1493">bitmask applied to each scanned word and each value before comparing</doc>
