            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="869">the interceptor</doc>
            <type name="Interceptor" c:type="GumInterceptor*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="detach" c:identifier="gum_interceptor_detach">
        <doc xml:space="preserve"
             filename="gum/guminterceptor.c"
             line="624">Detaches @listener from every function it is currently attached to, undoing
any [method@Gum.Interceptor.attach] calls made with it. Functions left
without any listeners or replacement are restored to their original state.

The change takes effect immediately unless a transaction is open.</doc>
        <source-position filename="gum/guminterceptor.h" line="108"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
