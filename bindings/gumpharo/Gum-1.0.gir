            <doc xml:space="preserve"
                 filename="gum/gumdarwingrafter.c"
                 line="318">file offset of the instruction to reserve a trampoline for</doc>
            <type name="guint32" c:type="guint32"/>
          </parameter>
        </parameters>
      </method>
      <method name="graft" c:identifier="gum_darwin_grafter_graft" throws="1">
        <doc xml:space="preserve"
             filename="gum/gumdarwingrafter.c"
             line="330">Grafts trampolines for all collected code offsets and writes the modified
binary back to its original path. Fails if the binary has already been
grafted; if there is nothing to instrument it succeeds without touching the
file.</doc>
        <source-position filename="gum/gumdarwingrafter.h" line="31"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/gumdarwingrafter.c"
               line="340">%TRUE on success, %FALSE on failure with @error set</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/gumdarwingrafter.c"
                 line="332">a #GumDarwinGrafter</doc>
            <type name="DarwinGrafter" c:type="GumDarwinGrafter*"/>
          </instance-parameter>
        </parameters>
      </method>
      <property name="flags"
                writable="1"
                construct-only="1"
                transfer-ownership="none"
                default-value="GUM_DARWIN_GRAFTER_FLAGS_NONE">
        <type name="DarwinGrafterFlags"/>
