      <method name="attach" c:identifier="gum_interceptor_attach">
        <doc xml:space="preserve"
             filename="gum/guminterceptor.c"
             line="534">Attaches @listener so that it is notified right before @target is entered and
right after it returns. The same listener may be attached to any number of
addresses, and multiple listeners may be attached to the same address. The
original code is left in place.

@target need not be a function entry: a listener that implements
only `on_enter` acts as a probe and may be placed at an arbitrary
instruction to observe execution reaching that point.

The change takes effect immediately unless a transaction is open.</doc>
        <source-position filename="gum/guminterceptor.h" line="105"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/guminterceptor.c"
               line="552">%GUM_ATTACH_OK on success, or another [enum@Gum.AttachReturn]
  describing why the function could not be instrumented</doc>
          <type name="AttachReturn" c:type="GumAttachReturn"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="536">the interceptor</doc>
            <type name="Interceptor" c:type="GumInterceptor*"/>
          </instance-parameter>
          <parameter name="target" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="537">address to intercept</doc>
            <type name="gpointer" c:type="gpointer"/>
          </parameter>
          <parameter name="listener" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="538">listener notified on enter and leave</doc>
            <type name="InvocationListener" c:type="GumInvocationListener*"/>
          </parameter>
          <parameter name="options"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="539">attach options, or %NULL for the defaults</doc>
            <type name="AttachOptions" c:type="const GumAttachOptions*"/>
