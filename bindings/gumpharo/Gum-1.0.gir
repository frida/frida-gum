    <callback name="ControlFlowGraphFindRangeFunc"
              c:type="GumControlFlowGraphFindRangeFunc">
      <doc xml:space="preserve"
           filename="gum/gumcontrolflowgraph.h"
           line="21">Resolves the contiguous range of code that @address belongs to. Called for
the entry, and for every direct branch target that falls outside the ranges
discovered so far — this is how a function split across multiple ranges (e.g.
a hot body plus a cold .text.unlikely fragment) gets stitched together.</doc>
      <source-position filename="gum/gumcontrolflowgraph.h" line="34"/>
      <return-value transfer-ownership="none">
        <doc xml:space="preserve"
             filename="gum/gumcontrolflowgraph.h"
             line="32">%TRUE if a range was found</doc>
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
      <parameters>
        <parameter name="address"
                   transfer-ownership="none"
                   nullable="1"
                   allow-none="1">
          <doc xml:space="preserve"
               filename="gum/gumcontrolflowgraph.h"
               line="23">a code address to locate</doc>
          <type name="gpointer" c:type="gconstpointer"/>
        </parameter>
        <parameter name="range"
                   direction="out"
                   caller-allocates="1"
                   transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/gumcontrolflowgraph.h"
               line="24">the contiguous code range covering @address</doc>
          <type name="MemoryRange" c:type="GumMemoryRange*"/>
        </parameter>
        <parameter name="user_data"
                   transfer-ownership="none"
                   nullable="1"
                   allow-none="1"
                   closure="2">
          <doc xml:space="preserve"
               filename="gum/gumcontrolflowgraph.h"
               line="25">data passed to gum_control_flow_graph_new()</doc>
