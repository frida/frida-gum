      <method name="replace" c:identifier="gum_interceptor_replace">
        <doc xml:space="preserve"
             filename="gum/guminterceptor.c"
             line="681">Replaces @function_address with @replacement_function, so that any call to
it ends up in the replacement instead. The replacement can still reach the
original by calling @function_address itself — the interceptor routes that
call to the original rather than recursing — or through @original_function
if a pointer is more convenient.

Undo with [method@Gum.Interceptor.revert]. The change takes effect
immediately unless a transaction is open.</doc>
        <source-position filename="gum/guminterceptor.h" line="111"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/guminterceptor.c"
               line="699">%GUM_REPLACE_OK on success, or another [enum@Gum.ReplaceReturn]
  describing why the function could not be instrumented</doc>
          <type name="ReplaceReturn" c:type="GumReplaceReturn"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="683">the interceptor</doc>
            <type name="Interceptor" c:type="GumInterceptor*"/>
          </instance-parameter>
          <parameter name="function_address" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="684">address of the function to replace</doc>
            <type name="gpointer" c:type="gpointer"/>
          </parameter>
          <parameter name="replacement_function" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="685">address of the replacement</doc>
            <type name="gpointer" c:type="gpointer"/>
          </parameter>
          <parameter name="original_function"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full"
                     nullable="1"
                     optional="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="686">return location for a
  pointer through which the original function can be called, or %NULL</doc>
            <type name="gpointer" c:type="gpointer*"/>
          </parameter>
          <parameter name="options"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="688">replace options, or %NULL for the defaults</doc>
            <type name="ReplaceOptions" c:type="const GumReplaceOptions*"/>
          </parameter>
        </parameters>
      </method>
      <method name="replace_fast" c:identifier="gum_interceptor_replace_fast">
        <doc xml:space="preserve"
             filename="gum/guminterceptor.c"
             line="719">Like [method@Gum.Interceptor.replace], but trades flexibility for speed by
patching @function_address to branch straight to @replacement_function with
no trampoline in between. A trampoline is only involved if you ask for
@original_function, which you must use to reach the original — unlike
[method@Gum.Interceptor.replace], calling @function_address again would just
re-enter the replacement. A target replaced this way cannot also be attached
to; use [method@Gum.Interceptor.replace] if you need that.

Prefer this when the hook is on a hot path and the extra machinery of the
default replacement is not needed.</doc>
        <source-position filename="gum/guminterceptor.h" line="114"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gum/guminterceptor.c"
               line="739">%GUM_REPLACE_OK on success, or another [enum@Gum.ReplaceReturn]
  describing why the function could not be instrumented</doc>
          <type name="ReplaceReturn" c:type="GumReplaceReturn"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="721">the interceptor</doc>
            <type name="Interceptor" c:type="GumInterceptor*"/>
          </instance-parameter>
          <parameter name="function_address" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="722">address of the function to replace</doc>
            <type name="gpointer" c:type="gpointer"/>
          </parameter>
          <parameter name="replacement_function" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="723">address of the replacement</doc>
            <type name="gpointer" c:type="gpointer"/>
          </parameter>
          <parameter name="original_function"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full"
                     nullable="1"
                     optional="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="724">return location for a
  pointer through which the original function can still be called, or %NULL</doc>
            <type name="gpointer" c:type="gpointer*"/>
          </parameter>
          <parameter name="options"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gum/guminterceptor.c"
                 line="726">instrumentation options, or %NULL for the defaults</doc>
