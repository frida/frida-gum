      <doc xml:space="preserve"
           filename="gum/gummodulemap.c"
           line="30">A snapshot of the process's loaded modules, ordered for fast lookup of the
module containing a given address.

The map is populated when created and can be refreshed with
[method@Gum.ModuleMap.update] after modules are loaded or unloaded. A
filtered map retains only the modules accepted by a
[callback@Gum.ModuleMapFilterFunc], handy for narrowing lookups to a subset
such as your own modules.</doc>
      <source-position filename="gum/gummodulemap.h" line="15"/>
      <constructor name="new" c:identifier="gum_module_map_new">
        <doc xml:space="preserve"
             filename="gum/gummodulemap.c"
             line="86">Creates a module map covering all of the process's currently loaded modules.</doc>
        <source-position filename="gum/gummodulemap.h" line="20"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="gum/gummodulemap.c"
