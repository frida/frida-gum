    <enumeration name="InterceptorScenario"
                 glib:type-name="GumInterceptorScenario"
                 glib:get-type="gum_interceptor_scenario_get_type"
                 c:type="GumInterceptorScenario">
      <doc xml:space="preserve"
           filename="gum/guminterceptor.c"
           line="347">Whether other threads may be running the code being instrumented. When the
target is known to be quiescent — for example a process freshly created with
`spawn()` whose main thread is still suspended before `main()` —
%GUM_INTERCEPTOR_SCENARIO_OFFLINE lets it rewrite more freely, e.g.
overwriting past a `CALL` since no other thread can already be inside the
call waiting to return. %GUM_INTERCEPTOR_SCENARIO_ONLINE is the safe choice
for live processes where such concurrency is possible.</doc>
      <member name="default"
              value="0"
              c:identifier="GUM_INTERCEPTOR_SCENARIO_DEFAULT"
              glib:nick="default"
              glib:name="GUM_INTERCEPTOR_SCENARIO_DEFAULT">
        <doc xml:space="preserve"
             filename="gum/guminterceptor.c"
             line="349">use the interceptor's configured default</doc>
      </member>
      <member name="online"
              value="1"
              c:identifier="GUM_INTERCEPTOR_SCENARIO_ONLINE"
              glib:nick="online"
              glib:name="GUM_INTERCEPTOR_SCENARIO_ONLINE">
        <doc xml:space="preserve"
             filename="gum/guminterceptor.c"
             line="350">other threads may be executing the target
  code, so it must be instrumented conservatively</doc>
      </member>
      <member name="offline"
              value="2"
              c:identifier="GUM_INTERCEPTOR_SCENARIO_OFFLINE"
              glib:nick="offline"
              glib:name="GUM_INTERCEPTOR_SCENARIO_OFFLINE">
        <doc xml:space="preserve"
             filename="gum/guminterceptor.c"
             line="352">the target is quiescent, allowing more
  aggressive rewriting</doc>
      </member>
    </enumeration>
