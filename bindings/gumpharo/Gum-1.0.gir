          </instance-parameter>
          <parameter name="func"
                     transfer-ownership="none"
                     scope="call"
                     closure="1">
            <doc xml:space="preserve"
                 filename="gum/gummoduleregistry.c"
                 line="254">function called with each #GumModule</doc>
            <type name="FoundModuleFunc" c:type="GumFoundModuleFunc"/>
