  EXPORT gum_stalker_follow_me
  EXPORT gum_stalker_activate
  EXPORT gum_stalker_deactivate

  IMPORT _gum_stalker_do_follow_me
  IMPORT _gum_stalker_do_activate
  IMPORT _gum_stalker_do_deactivate

  AREA |.text|, CODE, ALIGN=8

|gum_stalker_follow_me| PROC
  mov x3, x30
  bl _gum_stalker_do_follow_me
  cbz x0, follow_unfollowed
  stp x21, x22, [x0, #0]
  stp x23, x24, [x0, #16]
  stp x25, x26, [x0, #32]
  stp x27, x28, [x0, #48]
  ldr x30, [x0, #64]
  b follow_resume
follow_unfollowed
  mov x30, x1
follow_resume
  mov x0, x1
  br x0
  ENDP

|gum_stalker_activate| PROC
  sub sp, sp, #64
  stp x21, x22, [sp, #0]
  stp x23, x24, [sp, #16]
  stp x25, x26, [sp, #32]
  stp x27, x28, [sp, #48]
  mov x3, sp
  mov x2, x30
  bl _gum_stalker_do_activate
  ldp x21, x22, [sp, #0]
  ldp x23, x24, [sp, #16]
  ldp x25, x26, [sp, #32]
  ldp x27, x28, [sp, #48]
  add sp, sp, #64
  mov x30, x1
  br x0
  ENDP

|gum_stalker_deactivate| PROC
  mov x1, x30
  bl _gum_stalker_do_deactivate
  mov x30, x1
  br x0
  ENDP

  END
